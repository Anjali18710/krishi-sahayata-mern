# Copy this file to ".env" (in this same server/ folder) and fill in the values.
# Never commit the real .env file - it is already listed in .gitignore.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers), or a local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/krishi-sahayata

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL of the React app (comma-separate several). Needed for CORS.
CLIENT_URL=http://localhost:5173

# Twilio (your own free trial account). Leave empty to print SMS/OTP to the terminal instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# true = show the OTP on screen (for a public demo where visitors can't receive SMS)
DEMO_MODE=false

# Optional AI claim summaries. Leave both empty to disable the feature.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# A claim stuck in the same status for longer than this is marked overdue
SLA_DAYS=7

# Daily weather alert job, cron syntax in Indian time (default 6:00 AM). "off" disables it.
WEATHER_ALERT_CRON=0 6 * * *
